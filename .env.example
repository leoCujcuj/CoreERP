# Configuracion de Entorno para CoreERP Docker Compose
# Copia este archivo a '.env' y ajusta los valores segun tu entorno.

# Base de datos SQL Server
MSSQL_SA_PASSWORD=Password123*!

# Configuracion de Seguridad JWT
JWT_KEY=CoreERP_SuperSecret_Jwt_Key_2026_Min256BitsLong!
JWT_ISSUER=CoreERP
JWT_AUDIENCE=CoreERPClient

# Credenciales iniciales del Administrador
ADMIN_PASSWORD=AdminStrongPassword123*!
